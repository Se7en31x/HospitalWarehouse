generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["inventory", "public"]
}

model inventory_snapshot {
  id           Int         @id @default(autoincrement())
  date         DateTime    @db.Date
  item_id      String?     @db.Uuid
  warehouse_id String?     @db.Uuid
  quantity     Int
  avg_cost     Decimal?    @db.Decimal(10, 2)
  items        items?      @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_snapshot_item_fk")
  warehouse    warehouses? @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_snapshot_warehouse_fk")

  @@unique([date, item_id, warehouse_id], map: "inventory_snapshot_unique_idx")
  @@index([date])
  @@schema("inventory")
}

model item_allocation {
  id               Int               @id @default(autoincrement())
  req_item_id      Int?
  lot_id           String?           @db.Uuid
  qty              Int
  status           String?           @default("PENDING") @db.VarChar(20)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  item_lot         item_lots?        @relation(fields: [lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_allocation_lot_fk")
  requisition_item requisition_item? @relation(fields: [req_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "item_allocation_req_item_fk")

  @@schema("inventory")
}

model items {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  code               String               @unique(map: "items_code_unique")
  category_id        String?              @db.Uuid
  unit_id            String?              @db.Uuid
  min_stock          Int?                 @default(0)
  current_stock      Int?                 @default(0)
  image_url          String?
  status             String?              @default("ACTIVE") @db.VarChar(20)
  sell_price         Decimal?             @default(0) @db.Decimal(10, 2)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?            @db.Timestamptz(6)
  warehouse_id       String?              @db.Uuid
  description        String?
  image_public_id    String?              @db.VarChar(100)
  type               String?              @default("CONSUMABLE") @db.VarChar(20)
  allowed_req        Boolean?             @default(true)
  allowed_borrow     Boolean?             @default(false)
  inventory_snapshot inventory_snapshot[]
  item_lots          item_lots[]
  categories         categories?          @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_category_fk")
  unit               units?               @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_unit_fk")
  warehouses         warehouses?          @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_warehouse_fk")
  medical_assets     medical_assets[]
  receive_item       receive_item[]
  requisition_item   requisition_item[]
  stocks_movement    stocks_movement[]

  @@schema("inventory")
}

model logs_transaction {
  id            Int       @id @default(autoincrement())
  action        String    @db.VarChar(50)
  module        String    @db.VarChar(50)
  code          String?   @db.VarChar(50)
  status        String?   @db.VarChar(20)
  description   String?
  created_by    String?   @db.VarChar(100)
  created_by_id Int?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([action])
  @@index([code])
  @@index([created_at])
  @@schema("inventory")
}

model requisition_header {
  id               Int                @id @default(autoincrement())
  doc_no           String             @unique @db.VarChar(50)
  type             String             @db.VarChar(50)
  status           String?            @default("DRAFT") @db.VarChar(50)
  department_code  String?            @db.VarChar(255)
  department_name  String?            @db.VarChar(255)
  requester_id     Int
  approver_id      Int?
  request_date     DateTime?          @default(now()) @db.Timestamptz(6)
  due_date         DateTime?          @db.Timestamptz(6)
  return_date      DateTime?          @db.Timestamptz(6)
  note             String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @updatedAt @db.Timestamptz(6)
  requisition_item requisition_item[]

  @@index([doc_no], map: "idx_req_header_doc_no")
  @@index([status], map: "idx_req_header_status")
  @@schema("inventory")
}

model requisition_item {
  id                 Int                @id @default(autoincrement())
  header_id          Int
  item_id            String?            @db.Uuid
  req_qty            Int
  approved_qty       Int?
  issued_qty         Int?               @default(0)
  returned_qty       Int?               @default(0)
  note               String?
  item_allocation    item_allocation[]
  requisition_header requisition_header @relation(fields: [header_id], references: [id], onDelete: Cascade, map: "requisition_item_header_fk")
  items              items?             @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "requisition_item_item_fk")

  @@index([header_id], map: "idx_req_item_header")
  @@schema("inventory")
}

model categories {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  code_prefix String    @db.VarChar(10)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  items       items[]

  @@schema("inventory")
}

model item_lots {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_code        String            @db.VarChar(100)
  item_id         String?           @db.Uuid
  warehouse_id    String?           @db.Uuid
  quantity        Int?              @default(0)
  status          String?           @default("ACTIVE") @db.VarChar(20)
  expired_at      DateTime?         @db.Timestamptz(6)
  note            String?           @db.VarChar(255)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)
  item_allocation item_allocation[]
  items           items?            @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_lot_item_fk")
  warehouses      warehouses?       @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_lot_warehouse_fk")

  @@unique([item_id, lot_code], map: "item_lot_unique_idx")
  @@schema("inventory")
}

model stocks_movement {
  id            Int       @id(map: "stock_movement_pkey") @default(autoincrement())
  item_id       String?   @db.Uuid
  lot_id        String?   @db.Uuid
  quantity      Int?      @default(0)
  type          String    @db.VarChar(50)
  note          String?
  created_by    String?
  created_by_id Int?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  items         items?    @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movement_item_fk")

  @@schema("inventory")
}

model units {
  id          String    @id(map: "unit_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  description String?
  deleted_at  DateTime? @db.Timestamptz(6)
  items       items[]

  @@schema("inventory")
}

model warehouses {
  id                 String               @id(map: "warehouse_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  location           String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  description        String?
  deleted_at         DateTime?            @db.Timestamptz(6)
  inventory_snapshot inventory_snapshot[]
  item_lots          item_lots[]
  items              items[]

  @@schema("inventory")
}

model departments {
  id             Int              @id
  name           String?          @db.VarChar(255)
  description    String?          @db.VarChar(255)
  created_at     DateTime?        @db.Timestamptz(6)
  updated_at     DateTime?        @db.Timestamptz(6)
  deleted_at     DateTime?        @db.Timestamptz(6)
  is_disable     Boolean?
  code           String?          @db.VarChar
  medical_assets medical_assets[]

  @@schema("public")
}

model sex {
  id          Int     @id
  name        String? @db.VarChar(25)
  description String? @db.VarChar

  @@schema("public")
}

model supplier {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  contact        String?
  address        String?
  phone          String?
  tax_id         String?
  active         Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?        @db.Timestamptz(6)
  receive_header receive_header[]

  @@schema("public")
}

model users {
  id                String           @id @db.Uuid
  firstname_th      String?          @db.VarChar(255)
  lastname_th       String?          @db.VarChar(255)
  firstname_en      String?          @db.VarChar(255)
  lastname_en       String?          @db.VarChar(255)
  sex_id            Int?
  birth_date        DateTime?        @db.Date
  nationality       Int?
  race              Int?
  mstatus           Int?
  occupation        Int?
  phone             String?          @db.VarChar(15)
  current_maininscl Int?
  subdistrict_code  Int?
  district_code     Int?
  province_code     Int?
  zip_code          Int?
  address_detail    String?          @db.VarChar(255)
  cid               String?          @db.VarChar(13)
  profession_id     String?          @db.VarChar(50)
  title_code        String?          @db.VarChar(3)
  receive_header    receive_header[]

  @@schema("public")
}

model receive_header {
  id                   Int              @id @default(autoincrement())
  doc_no               String           @unique @db.VarChar(50)
  type                 String           @db.VarChar(50)
  status               String?          @default("PENDING") @db.VarChar(50)
  supplier_id          String?          @db.Uuid
  donor_name           String?          @db.VarChar(255)
  receive_date         DateTime?        @default(now()) @db.Timestamptz(6)
  note                 String?
  created_by           String?          @db.Uuid
  created_at           DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?        @default(now()) @db.Timestamptz(6)
  parent_id            Int?
  receive_header       receive_header?  @relation("receive_headerToreceive_header", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_receive_header receive_header[] @relation("receive_headerToreceive_header")
  supplier             supplier?        @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "receive_header_supplier_fk")
  users                users?           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "receive_header_users_fk")
  receive_item         receive_item[]

  @@index([doc_no], map: "idx_receive_header_doc_no")
  @@index([type], map: "idx_receive_header_type")
  @@schema("inventory")
}

model receive_item {
  id             Int              @id @default(autoincrement())
  header_id      Int
  item_id        String           @db.Uuid
  lot_code       String?          @db.VarChar(100)
  qty            Int              @default(0)
  cost_price     Decimal?         @default(0) @db.Decimal(10, 2)
  expired_at     DateTime?        @db.Timestamptz(6)
  expected_qty   Int              @default(0)
  medical_assets medical_assets[]
  receive_header receive_header   @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "receive_item_header_fk")
  items          items            @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "receive_item_item_fk")

  @@index([header_id], map: "idx_receive_item_header")
  @@schema("inventory")
}

model lookup_mstatus {
  id           Int    @id(map: "PK_dfbf6d4b32123b3bbbdff1e0d54") @default(autoincrement())
  mstatus_code String @db.VarChar(1)
  mstatus      String @db.VarChar(100)

  @@schema("public")
}

model lookup_nations {
  id          Int    @id(map: "PK_1bd270efacb26e68fbb8d12ef7c") @default(autoincrement())
  nation_code String @db.VarChar(3)
  nation      String @db.VarChar(100)

  @@schema("public")
}

model lookup_occupations {
  id         Int    @id(map: "PK_49837c24f923ddf84b08b0fb7d8") @default(autoincrement())
  occup_code String @db.VarChar(5)
  name       String

  @@schema("public")
}

model lookup_titles {
  id         Int     @id(map: "PK_91f4e50664963211a976045aee4") @default(autoincrement())
  title_code String  @db.VarChar(3)
  short_name String? @db.VarChar(50)
  name       String  @db.VarChar(100)

  @@schema("public")
}

model lookup_abogroups {
  id            Int    @id(map: "PK_223edcc0b6512332c59096d3ad0") @default(autoincrement())
  abogroup_code String @db.VarChar(1)
  abogroup      String @db.VarChar(10)

  @@schema("public")
}

model lookup_rh {
  id      Int    @id(map: "PK_30ce7a1a93a51c6e4cf24514f95") @default(autoincrement())
  rh_code String @db.VarChar(1)
  rhgroup String @db.VarChar(10)

  @@schema("public")
}

model medical_assets {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_code      String        @unique @db.VarChar(50)
  item_id         String        @db.Uuid
  receive_item_id Int?
  serial_no       String?       @db.VarChar(100)
  department_id   Int?
  status          String        @default("READY") @db.VarChar(20)
  purchase_date   DateTime?     @db.Timestamptz(6)
  warranty_expire DateTime?     @db.Timestamptz(6)
  note            String?
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @updatedAt @db.Timestamptz(6)
  departments     departments?  @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_department")
  items           items         @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_item")
  receive_item    receive_item? @relation(fields: [receive_item_id], references: [id], onUpdate: NoAction, map: "fk_asset_receive_item")

  @@index([asset_code], map: "idx_medical_assets_asset_code")
  @@index([department_id], map: "idx_medical_assets_dept_id")
  @@index([item_id], map: "idx_medical_assets_item_id")
  @@index([status], map: "idx_medical_assets_status")
  @@schema("inventory")
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view view_items {
  id             String    @unique @db.Uuid
  code           String?
  name           String?
  description    String?
  category_id    String?   @db.Uuid
  category_name  String?   @db.VarChar(255)
  unit_id        String?   @db.Uuid
  unit_name      String?
  warehouse_id   String?   @db.Uuid
  warehouse_name String?
  current_stock  Int?
  min_stock      Int?
  sell_price     Decimal?  @db.Decimal(10, 2)
  status         String?   @db.VarChar(20)
  image_url      String?
  created_at     DateTime? @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  @@schema("inventory")
}
